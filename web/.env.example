# The game stays closed (wish list only) until this is true.
VITE_GAME_OPEN=
# Go API (Render in production)
VITE_API_URL=http://localhost:8080/api/v1
# https://account.mapbox.com/access-tokens — without it the game uses an offline stylised map
VITE_MAPBOX_TOKEN=
# Google Cloud console → OAuth 2.0 Client ID (Web). Same value as the backend's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
# Firebase console → Project settings → Your apps. Google sign-in uses these.
# Also add lifeinbabi.com and www.lifeinbabi.com under Authentication → Settings → Authorized domains.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# 1 once https://<the site>/__/auth/handler is among the OAuth client's authorized redirect URIs
# (Google Cloud console): from the iPhone's home screen, Google sign-in then goes to Google and back
# through the site's own domain (api/fbauth.ts) instead of a window that never comes back.
VITE_FIREBASE_SAME_DOMAIN=
