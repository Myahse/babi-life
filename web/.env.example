# Go API (Render in production)
VITE_API_URL=http://localhost:8080/api/v1
# https://account.mapbox.com/access-tokens — without it the game uses an offline stylised map
VITE_MAPBOX_TOKEN=
# Google Cloud console → OAuth 2.0 Client ID (Web). Same value as the backend's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
