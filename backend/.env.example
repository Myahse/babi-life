# Neon: Dashboard → Connection details → copy the connection string (keep sslmode=require)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ivoire?sslmode=disable
# openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web)
GOOGLE_CLIENT_ID=
# Comma-separated front-end origins (add your Vercel URL in production)
ALLOWED_ORIGINS=http://localhost:5173
# Lets you play locally without Google. Never set this on Render.
DEV_LOGIN=true
PORT=8080
